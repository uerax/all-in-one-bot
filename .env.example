# Note: 除环境变量外，项目也支持通过 YAML 配置文件启动：
#   ./all-in-one-bot -config ./config.yaml
# 模板参考根目录 config.example.yaml。
# 配置优先级：环境变量 > YAML 配置文件 > 内置默认值。
# 即：同一字段同时配置时，环境变量生效；YAML 仅在环境变量缺失时填充并覆盖内置默认。
# systemd 部署建议把敏感凭据放在 EnvironmentFile，结构性配置写在 config.yaml。

# ==============================================================================
# Telegram 机器人配置(必填)
# ==============================================================================
# Telegram Bot Token (从 Telegram @BotFather 申请获取)
TELEGRAM_TOKEN=

# Telegram Long Polling (长轮询) 超时时间，单位：秒 (默认: 10)
TELEGRAM_TIMEOUT=10

# 管理员 Telegram ID 白名单，多个用英文逗号 (,) 分隔。
# 非白名单用户发送的命令会被静默丢弃（仅记日志）。
# 留空则不对命令做鉴权，所有用户均可使用 (默认行为)。
# 获取你的 ID：给 bot 发 /chatid。
TELEGRAM_ADMIN_IDS=


# ==============================================================================
# Polymarket 预测市场配置
# ==============================================================================
# Polymarket Gamma API 基础 URL (默认: https://gamma-api.polymarket.com)
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com

# Polymarket CLOB 订单簿 API 基础 URL (默认: https://clob.polymarket.com)
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# 请求 API 的超时时间，单位：秒 (默认: 10)
POLYMARKET_TIMEOUT=10

# 列表查询 (如 markets/events) 默认返回的最大记录条数 (默认: 10)
POLYMARKET_DEFAULT_LIMIT=10

# 用户的 Polygon 钱包地址 (0x 开头，40位十六进制，用于 L2 鉴权与持仓查询)
POLYMARKET_ADDRESS=

# Polymarket CLOB API Key (L2 鉴权必需)
POLYMARKET_API_KEY=

# Polymarket CLOB API Secret (L2 HMAC 签名必需)
POLYMARKET_API_SECRET=

# Polymarket CLOB API Passphrase (L2 鉴权必需)
POLYMARKET_API_PASSPHRASE=


# ==============================================================================
# Bitcointalk 论坛监控配置
# ==============================================================================
# 去重已通知主题的 LRU 缓存数量上限 (默认: 60)
BITCOINTALK_LIMIT=60

# 监控抓取的 Bitcointalk 版块 URL (默认: Altcoin Announcements 版块 159.0)
BITCOINTALK_URL=https://bitcointalk.org/index.php?board=159.0

# 轮询检查新帖的时间间隔，单位：秒 (默认: 60)
BITCOINTALK_INTERVAL=60


# ==============================================================================
# NodeSeek 论坛 RSS 监控配置
# ==============================================================================
# 关键字与已通知主题的 LRU 缓存上限 (默认: 60)
NODESEEK_LIMIT=60

# NodeSeek RSS 源地址 (默认: https://rss.nodeseek.com/)
NODESEEK_URL=https://rss.nodeseek.com/

# 轮询 RSS 的时间间隔，单位：秒 (默认: 60)
NODESEEK_INTERVAL=60


# ==============================================================================
# 数据存储 (Store) 配置
# ==============================================================================
# 数据存储引擎类型 (目前支持: file)
DATABASE_TYPE=file

# 存储基准路径：可填远程 HTTP(S) URL (如 GitHub Raw)，也可填本地文件系统绝对路径 (如 /var/lib/aio/data)
# 远端需包含对应的 json/dat 结构 (如 coingecko/list.json, nodeseek/keyword.json)
DATABASE_FILE_PATH=https://raw.githubusercontent.com/uerax/all-in-one-bot/refs/heads/lite/data


# ==============================================================================
# CoinGecko 行情与持仓报告配置
# ==============================================================================
# CoinGecko Demo API Keys，支持填写多个，使用英文逗号 (,) 分隔。
# 请求时程序会自动进行轮询 (Round-Robin) 以摊薄单个 Key 的频率限制 (Rate Limit)
# 示例: COINGECKO_KEYS=CG-Key1xxxxxx,CG-Key2yyyyyy
COINGECKO_KEYS=


# ==============================================================================
# Crocodile (鳄鱼量能扫描引擎) 配置
# ==============================================================================
# 回望天数：计算前 N 天交易量的平均值 (默认: 5)
CROCODILE_LOOKBACK=5

# 昨日量能触发倍数：今日成交量 >= 昨日成交量 * N (默认: 3.0)
CROCODILE_YESTERDAY_MULTIPLE=3.0

# 均值量能触发倍数：今日成交量 >= 回望天数均值成交量 * N (默认: 2.0)
CROCODILE_AVERAGE_MULTIPLE=2.0

# 自动定时量能扫描的时间间隔，单位：秒 (默认: 86400，即每天在 UTC 00:05 触发)
CROCODILE_INTERVAL=86400
